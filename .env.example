# Postgres connection (drizzle / pg)
DATABASE_URL=postgres://user:password@localhost:5432/gdarena

# LLM (optional but strongly recommended). Without a key the app falls back to
# the template-based director and the heuristic report.
ANTHROPIC_API_KEY=
# Fast, cheap model for participant/moderator turns
DIRECTOR_MODEL=claude-haiku-5-5
# Stronger model used once per session for the feedback report
REPORT_MODEL=claude-sonnet-5-5
